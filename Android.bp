cc_prebuilt_library_shared {
    name: "libpowerstatshaldataprovider",
    compile_multilib: "64",
    target: {
        android_arm64: {
            srcs: ["prebuilt/arm64/libpowerstatshaldataprovider.so"],
        },
    },
    shared_libs: [
        "android.hardware.power.stats-V1-ndk",
        "android.hardware.power.stats@1.0",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libnativehelper",
        "libprotobuf-cpp-lite",
        "libutils",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

android_app {
    name: "TurboAdapter",
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
        "proto/**/*.proto",
    ],
    aidl: {
        local_include_dirs: ["src"],
    },
    proto: {
        type: "lite",
    },
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    jni_libs: ["libpowerstatshaldataprovider"],
    static_libs: [
        "//hardware/google/interfaces:pixel-power-ext-V2-java",
        "SuspendProperties",
        "android.system.suspend.control.internal-java",
        "androidx.annotation_annotation",
        "googlebattery-lib",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
